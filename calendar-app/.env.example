# Generate a unique value; never commit the real production secret.
SESSION_SECRET=replace-with-a-random-64-character-secret
COOKIE_SECURE=true
PORT=3000
DATA_DIR=/app/data
APP_BASE_URL=https://calendar.garyhub.uk
DEFAULT_TIMEZONE=Etc/UTC

# Email delivery. Leave unset in development when using a test transport.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM_NAME=Gary Hub
SMTP_FROM_EMAIL=no-reply@example.com
EMAIL_VERIFICATION_PEPPER=replace-with-a-separate-random-secret
