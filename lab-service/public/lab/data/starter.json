              0.8775825618903728,
              0.479425538604203,
              0.0,
              2.0
            ],
            [
              -0.33900504942104487,
              0.6205445805637456,
              -0.7071067811865475,
              2.1213203435596424
            ],
            [
              -0.3390050494210448,
              0.6205445805637455,
              0.7071067811865476,
              -2.121320343559643
            ],
            [
              0.0,
              0.0,
              0.0,
              1.0
