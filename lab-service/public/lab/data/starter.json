    {
      "id": "rotation-z",
      "version": 1,
      "title": "Rotate about the z axis",
      "category": "Rotations",
      "similarity_group": "axis-angle",
      "statement_en": "Frames 0 and 1 are initially aligned. Frame 1 rotates by **theta radians** about the fixed **z₀ axis**. Find the rotation matrix **R01**. Use the numerical values below.",
      "inputs": {
        "axis": {
          "type": "array",
          "value": [
            0,
            0,
            1
          ]
        },
        "theta": {
          "type": "scalar",
          "value": -0.3,
          "random": {
            "min": -2.8,
            "max": 2.8,
            "step": 0.1,
            "unit": "rad"
          }
        }
      },
      "answers": [
        {
          "name": "R01",
          "shape": [
            3,
            3
          ],
          "rtol": 1e-05,
          "atol": 1e-07,
          "expected": [
            [
              0.955336489125606,
              0.29552020666133955,
              0.0
            ],
            [
              -0.29552020666133955,
              0.955336489125606,
              0.0
            ],
            [
              0.0,
              0.0,
              1.0
            ]
          ]
        }
      ],
      "reference_code": "R01 = MatrixExp3(VecToso3(axis * theta))",
      "formula_latex": "R_{01}=e^{[\\hat\\omega]\\theta}",
      "explanation_md": "轴向量乘角度得到旋转向量；`VecToso3` converts the vector into a skew-symmetric matrix, and `MatrixExp3` computes the rotation.\n\n负角度直接代入。Do not invert again."
    },
