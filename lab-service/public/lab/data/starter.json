    {
      "id": "point-forward",
      "version": 1,
      "title": "Change point coordinates",
      "category": "Coordinates",
      "similarity_group": "point-transform",
      "statement_en": "The pose of frame b in frame a is given by **R_ab** and **p_ab**. The point is given in frame b. Compute its coordinates in frame a. Return a **(3, 1) column vector**.",
      "inputs": {
