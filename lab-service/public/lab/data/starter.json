          ]
        },
        "p_ab": {
          "type": "array",
          "value": [
            [
              1.0
            ],
            [
              2.0
            ],
            [
              0.0
            ]
          ]
        },
        "q_b": {
          "type": "array",
          "value": [
            [
              0.5
            ],
            [
              -1.0
            ],
            [
              2.0
            ]
          ],
          "random": {
            "min": -3,
            "max": 3,
            "step": 0.25,
            "unit": "length"
          }
        }
      },
      "answers": [
        {
          "name": "q_a",
          "shape": [
            3,
            1
          ],
          "rtol": 1e-05,
          "atol": 1e-07,
          "expected": [
            [
              1.9773102808498746
            ],
            [
              1.4569856217878394
            ],
            [
              2.0
            ]
          ]
        }
      ],
      "reference_code": "q_a = R_ab @ q_b + p_ab",
      "formula_latex": "q_a=R_{ab}q_b+p_{ab}",
      "explanation_md": "先确认坐标转换方向。Forward: rotate, then add the origin position. Inverse: subtract the origin position first, then rotate with the transpose.\n\n保持两个向量形状一致，避免 NumPy broadcasting."
    },
